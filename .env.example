# Másold .env néven és töltsd ki. A .env nincs verziókezelve.

# --- LLM (állítás-kinyerés és tényellenőrzés-vázlat) ---
# Ha üresen hagyod, a pipeline "mock" módban fut: előre elkészített
# minta adatokkal dolgozik, valódi API-hívás nélkül.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Instagram Graph API (saját business/creator fiók) ---
# A Business Discovery API-hoz és a saját posztok publikálásához kell.
# Ha üresen hagyod, a fetch/publish lépések dry-run/mock módban futnak.
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
